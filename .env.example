# ─── GitHub Configuration ───────────────────────────────────────
# Personal Access Token with repo scope (or fine-grained: Pull requests R/W + Contents R)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Webhook secret for HMAC signature verification (set this in GitHub webhook settings)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Default repository to review (owner/repo format)
TARGET_REPO=owner/repo-name

# ─── Anthropic / Claude Configuration ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model to use for code review (claude-sonnet-4-20250514 recommended for cost/quality balance)
REVIEW_MODEL=claude-sonnet-4-20250514

# ─── Application Settings ──────────────────────────────────────
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Server host/port for the webhook listener
HOST=0.0.0.0
PORT=8000

# ChromaDB persistent storage path
CHROMA_DB_PATH=./data/chroma_db

# SQLite feedback database path
FEEDBACK_DB_PATH=./data/feedback.db

# ─── Review Behavior ───────────────────────────────────────────
# Review event type: COMMENT (informational) or REQUEST_CHANGES (blocking)
REVIEW_EVENT=COMMENT

# Maximum findings to post per PR (avoid spamming)
MAX_FINDINGS_PER_PR=20

# Minimum severity to post: low, medium, high
MIN_SEVERITY=low
