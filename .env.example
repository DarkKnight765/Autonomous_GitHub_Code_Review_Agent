# ─── GitHub Configuration ───────────────────────────────────────
# Personal Access Token — needs 'repo' scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Webhook secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# The repo this agent will review PRs for (can be changed per deployment)
TARGET_REPO=owner/repo-name

# ─── LLM Provider ──────────────────────────────────────────────
# Options: groq | anthropic | gemini
LLM_PROVIDER=groq

# ─── Groq (FREE — 1M tokens/day, no credit card needed) ────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# ─── Anthropic Claude (Alternative) ───────────────────────────
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ─── Google Gemini (Alternative) ──────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_your_key_here

# ─── Model Selection ────────────────────────────────────────────
# Groq models:     llama-3.3-70b-versatile, llama-3.1-8b-instant
# Anthropic models: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# Gemini models:   gemini-2.0-flash, gemini-1.5-flash
REVIEW_MODEL=llama-3.3-70b-versatile

# ─── Application Settings ──────────────────────────────────────
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CHROMA_DB_PATH=./data/chroma_db
FEEDBACK_DB_PATH=./data/feedback.db

# ─── Review Behavior ───────────────────────────────────────────
# COMMENT: post as regular comments | REQUEST_CHANGES: request changes on PR
REVIEW_EVENT=COMMENT

# Maximum number of findings to post per PR
MAX_FINDINGS_PER_PR=20

# Minimum severity to report: low | medium | high
MIN_SEVERITY=low
